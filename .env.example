APP_NAME="CRYVEX Cloud"
APP_VERSION="0.1.0"
APP_ENV="development"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Database
DATABASE_URL="postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/cryvex_cloud"

# CORS
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Logging
LOG_LEVEL="INFO"

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT="100/minute"

# Security
SECRET_KEY="CHANGE_ME"
JWT_ALGORITHM="HS256"
TRUSTED_HOSTS='["*"]'

# ShopFlow Integration
SHOPFLOW_BASE_URL="http://localhost:8000"
SHOPFLOW_SERVICE_TOKEN="CHANGE_ME"
SHOPFLOW_TIMEOUT_SECONDS=30.0

